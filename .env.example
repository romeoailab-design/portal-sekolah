# ==========================================
# PORTAL SEKOLAH - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi ".env" untuk komputer lokal.
# Di cPanel DomaiNesia, masukkan variabel ini di menu:
# Setup Node.js App -> Environment Variables.
# ==========================================

# Server Port (di cPanel diisi otomatis oleh Passenger)
PORT=3000
NODE_ENV=development

# Database MySQL (Lokal Laragon / MySQL cPanel DomaiNesia)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_sekolah

# Keamanan Session JWT (WAJIB ganti dengan string acak panjang di produksi!)
JWT_SECRET=ganti_dengan_kode_rahasia_acak_minimal_32_karakter

# Google OAuth 2.0 Client ID (dari Google Cloud Console -> Credentials)
# Dipakai oleh Frontend (VITE_*) dan diverifikasi oleh Backend
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# (Opsional) Email Google Anda untuk otomatis dijadikan Platform Admin jika DB kosong
BOOTSTRAP_ADMIN_EMAIL=

# (Opsional) Domain inti SaaS tambahan, pisahkan dengan koma (misal: portal.smasdiponegoro.sch.id)
VITE_CORE_DOMAINS=

# (Opsional) Lokasi folder upload file (default: ./uploads)
UPLOAD_DIR=

# (Opsional) Gemini AI API Key untuk fitur AI Guru/TU/Kurikulum/Kalender
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# (Opsional) Fonnte WhatsApp API
FONNTE_TOKEN=
FONNTE_GROUP_ID=
